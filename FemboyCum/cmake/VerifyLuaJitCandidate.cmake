# Run both at configuration and immediately before compiling the copied vendor.
if(NOT DEFINED FC_LUAJIT_VENDOR_DIR)
  message(FATAL_ERROR "FC_LUAJIT_VENDOR_DIR is required")
endif()
if(NOT IS_DIRECTORY "${FC_LUAJIT_VENDOR_DIR}")
  message(FATAL_ERROR "LuaJIT vendor directory is missing")
endif()
file(REAL_PATH "${FC_LUAJIT_VENDOR_DIR}" _vendor_real)
set(_manifest "${FC_LUAJIT_VENDOR_DIR}/SOURCE_MANIFEST.json")
if(IS_SYMLINK "${_manifest}")
  message(FATAL_ERROR "Pinned LuaJIT manifest must not be a symlink")
endif()
file(SHA256 "${_manifest}" _manifest_sha)
if(NOT _manifest_sha STREQUAL "d544bb781e379f4d04fbb5693b0301564e85d75430bd728e76650e57d5d9aa8f")
  message(FATAL_ERROR "Pinned LuaJIT source manifest changed")
endif()
file(READ "${_manifest}" _json)
string(JSON _count LENGTH "${_json}" files)
math(EXPR _last "${_count} - 1")
set(_listed)
foreach(_index RANGE 0 ${_last})
  string(JSON _path GET "${_json}" files ${_index} path)
  string(JSON _expected GET "${_json}" files ${_index} sha256)
  if(_path MATCHES "(^/|(^|/)\\.\\.?(/|$)|\\\\|:)")
    message(FATAL_ERROR "Invalid pinned LuaJIT source path")
  endif()
  if(_path IN_LIST _listed)
    message(FATAL_ERROR "Duplicate pinned LuaJIT source path: ${_path}")
  endif()
  list(APPEND _listed "${_path}")
  set(_candidate "${FC_LUAJIT_VENDOR_DIR}/${_path}")
  if(NOT EXISTS "${_candidate}" OR IS_DIRECTORY "${_candidate}")
    message(FATAL_ERROR "Missing pinned LuaJIT source: ${_path}")
  endif()
  if(IS_SYMLINK "${_candidate}")
    message(FATAL_ERROR "Pinned LuaJIT source must not be a symlink: ${_path}")
  endif()
  file(REAL_PATH "${_candidate}" _resolved)
  set(_expected_path "${_vendor_real}/${_path}")
  cmake_path(NORMAL_PATH _expected_path)
  if(NOT _resolved STREQUAL _expected_path)
    message(FATAL_ERROR "Pinned LuaJIT source redirects outside its path: ${_path}")
  endif()
  file(SHA256 "${_candidate}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Pinned LuaJIT source hash mismatch: ${_path}")
  endif()
endforeach()

# msvcbuild.bat compiles/links lj_*.c and lib_*.c by wildcard. Copying any
# unlisted file into its build directory would weaken the source pin.
file(GLOB_RECURSE _entries LIST_DIRECTORIES true RELATIVE "${FC_LUAJIT_VENDOR_DIR}"
  "${FC_LUAJIT_VENDOR_DIR}/*")
foreach(_entry IN LISTS _entries)
  set(_candidate "${FC_LUAJIT_VENDOR_DIR}/${_entry}")
  if(IS_SYMLINK "${_candidate}")
    message(FATAL_ERROR "LuaJIT vendor contains a symlink: ${_entry}")
  endif()
  file(REAL_PATH "${_candidate}" _resolved)
  set(_expected_path "${_vendor_real}/${_entry}")
  cmake_path(NORMAL_PATH _expected_path)
  if(NOT _resolved STREQUAL _expected_path)
    message(FATAL_ERROR "LuaJIT vendor path redirects: ${_entry}")
  endif()
  if(IS_DIRECTORY "${_candidate}")
    continue()
  endif()
  if(_entry STREQUAL "SOURCE_MANIFEST.json")
    continue()
  endif()
  if(NOT _entry IN_LIST _listed)
    message(FATAL_ERROR "Unlisted LuaJIT vendor file: ${_entry}")
  endif()
endforeach()
