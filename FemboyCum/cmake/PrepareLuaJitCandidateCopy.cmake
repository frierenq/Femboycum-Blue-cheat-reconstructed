# Recreate only the dedicated scratch copy after source verification.
if(NOT DEFINED FC_LUAJIT_VENDOR_DIR OR NOT DEFINED FC_LUAJIT_BUILD_DIR OR
   NOT DEFINED FC_LUAJIT_COPY_DIR)
  message(FATAL_ERROR "LuaJIT vendor, build, and copy directories are required")
endif()
if(NOT IS_DIRECTORY "${FC_LUAJIT_VENDOR_DIR}" OR
   NOT IS_DIRECTORY "${FC_LUAJIT_BUILD_DIR}")
  message(FATAL_ERROR "LuaJIT vendor or build directory is missing")
endif()
file(REAL_PATH "${FC_LUAJIT_BUILD_DIR}" _build_real)
get_filename_component(_copy_name "${FC_LUAJIT_COPY_DIR}" NAME)
get_filename_component(_copy_parent "${FC_LUAJIT_COPY_DIR}" DIRECTORY)
file(REAL_PATH "${_copy_parent}" _parent_real)
set(_expected "${_build_real}/luajit-candidate-copy")
cmake_path(NORMAL_PATH _expected)
if(NOT _copy_name STREQUAL "luajit-candidate-copy" OR
   NOT _parent_real STREQUAL _build_real)
  message(FATAL_ERROR "LuaJIT scratch copy must be the exact build-directory child")
endif()
if(IS_SYMLINK "${FC_LUAJIT_COPY_DIR}")
  message(FATAL_ERROR "LuaJIT scratch copy must not be a symlink")
endif()
if(EXISTS "${FC_LUAJIT_COPY_DIR}")
  if(NOT IS_DIRECTORY "${FC_LUAJIT_COPY_DIR}")
    message(FATAL_ERROR "LuaJIT scratch copy path is not a directory")
  endif()
  file(REAL_PATH "${FC_LUAJIT_COPY_DIR}" _copy_real)
  if(NOT _copy_real STREQUAL _expected)
    message(FATAL_ERROR "LuaJIT scratch copy resolves outside the checked child path")
  endif()
  file(REMOVE_RECURSE "${_copy_real}")
endif()
file(COPY "${FC_LUAJIT_VENDOR_DIR}/" DESTINATION "${_expected}")
