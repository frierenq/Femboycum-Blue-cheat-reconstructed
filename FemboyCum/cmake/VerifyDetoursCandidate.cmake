# Run at configuration and before every optional Detours target build.
if(NOT DEFINED FC_DETOURS_VENDOR_DIR)
  message(FATAL_ERROR "FC_DETOURS_VENDOR_DIR is required")
endif()
if(IS_SYMLINK "${FC_DETOURS_VENDOR_DIR}")
  message(FATAL_ERROR "Pinned Detours root must not be a symlink")
endif()
if(NOT IS_DIRECTORY "${FC_DETOURS_VENDOR_DIR}")
  message(FATAL_ERROR "Detours vendor directory is missing")
endif()
file(REAL_PATH "${FC_DETOURS_VENDOR_DIR}" _vendor_real)
set(_manifest "${FC_DETOURS_VENDOR_DIR}/SOURCE_MANIFEST.json")
if(IS_SYMLINK "${_manifest}")
  message(FATAL_ERROR "Pinned Detours manifest must not be a symlink")
endif()
file(SHA256 "${_manifest}" _manifest_sha)
if(NOT _manifest_sha STREQUAL "26d6990fe515ce1a5f9107e47d87759c0e8e4589f3fc3d3f94652bbd3b2ad7d4")
  message(FATAL_ERROR "Pinned Detours source manifest changed")
endif()
file(READ "${_manifest}" _json)
string(JSON _count LENGTH "${_json}" files)
math(EXPR _last "${_count} - 1")
set(_listed)
foreach(_index RANGE 0 ${_last})
  string(JSON _path GET "${_json}" files ${_index} path)
  string(JSON _expected GET "${_json}" files ${_index} sha256)
  if(_path MATCHES "(^/|(^|/)\\.\\.?(/|$)|\\\\|:)")
    message(FATAL_ERROR "Invalid pinned Detours source path")
  endif()
  if(_path IN_LIST _listed)
    message(FATAL_ERROR "Duplicate pinned Detours source path: ${_path}")
  endif()
  list(APPEND _listed "${_path}")
  set(_candidate "${FC_DETOURS_VENDOR_DIR}/${_path}")
  if(NOT EXISTS "${_candidate}" OR IS_DIRECTORY "${_candidate}")
    message(FATAL_ERROR "Missing pinned Detours source: ${_path}")
  endif()
  if(IS_SYMLINK "${_candidate}")
    message(FATAL_ERROR "Pinned Detours source must not be a symlink: ${_path}")
  endif()
  file(REAL_PATH "${_candidate}" _resolved)
  set(_expected_path "${_vendor_real}/${_path}")
  cmake_path(NORMAL_PATH _expected_path)
  if(NOT _resolved STREQUAL _expected_path)
    message(FATAL_ERROR "Pinned Detours source redirects outside its path: ${_path}")
  endif()
  file(SHA256 "${_candidate}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Pinned Detours source hash mismatch: ${_path}")
  endif()
endforeach()

# Reject unlisted source/header files and path redirections as well as edits.
file(GLOB_RECURSE _entries LIST_DIRECTORIES true RELATIVE "${FC_DETOURS_VENDOR_DIR}"
  "${FC_DETOURS_VENDOR_DIR}/*")
foreach(_entry IN LISTS _entries)
  set(_candidate "${FC_DETOURS_VENDOR_DIR}/${_entry}")
  if(IS_SYMLINK "${_candidate}")
    message(FATAL_ERROR "Detours vendor contains a symlink: ${_entry}")
  endif()
  file(REAL_PATH "${_candidate}" _resolved)
  set(_expected_path "${_vendor_real}/${_entry}")
  cmake_path(NORMAL_PATH _expected_path)
  if(NOT _resolved STREQUAL _expected_path)
    message(FATAL_ERROR "Detours vendor path redirects: ${_entry}")
  endif()
  if(IS_DIRECTORY "${_candidate}")
    continue()
  endif()
  if(_entry STREQUAL "SOURCE_MANIFEST.json")
    continue()
  endif()
  if(NOT _entry IN_LIST _listed)
    message(FATAL_ERROR "Unlisted Detours vendor file: ${_entry}")
  endif()
endforeach()
